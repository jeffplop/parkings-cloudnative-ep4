# Copia este archivo como ".env" y ajústalo.
# En LOCAL deja PUBLIC_HOST=localhost.
# En AZURE pon la IP pública (o el DNS) de tu VM, p. ej. PUBLIC_HOST=20.51.xx.xx
PUBLIC_HOST=localhost

# RabbitMQ (clúster)
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_ERLANG_COOKIE=parkings-cookie

# Keycloak (consola de administración)
KC_ADMIN=admin
KC_ADMIN_PASSWORD=admin
